{
  "name": "rma-core",
  "version": "0.1.3",
  "private": true,
  "description": "react-monitor-agent core: localhost API + event store + checkpoint engine + decision reinjection (zero runtime deps)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./fold": "./dist/fold.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "npm run build:test && node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
